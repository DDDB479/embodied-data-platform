# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Node
node_modules/

# Generated by packages/dsh-plugin/scripts/prepack.mjs for npm tarballs.
packages/dsh-plugin/python/

# Local development support: generated fixtures, offline wheels and the vendored
# dependency tree used on machines where `pip install` is unavailable.
# The generator scripts themselves live in tools/ and are tracked.
.devtools/

# Catalogs and generated datasets
*.db
*.sqlite

# Never commit credentials (push helper reads this file, then deletes it)
.git-token.local
.env
.env.local

# Codex project-local MCP configuration may contain machine-specific paths.
.codex/


# Local run logs
*.log
