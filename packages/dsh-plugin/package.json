{
  "name": "dsh-embodied-data",
  "version": "0.1.0",
  "description": "DSH plugin + MCP server toolkit for embodied-AI data platforms: format detection, validation, quality control, segmentation, labeling tasks, conversion and cataloging for LeRobot, HDF5, RLDS, rosbag, MCAP and canonical JSONL datasets. Works with any MCP client (Codex, Claude Code, DeepSeek, Cursor, ...).",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./mcp": "./src/mcp.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "mcp-server",
    "embodied-ai",
    "robotics",
    "lerobot",
    "dataset",
    "data-quality"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDB479/embodied-data-platform.git"
  },
  "homepage": "https://github.com/DDDB479/embodied-data-platform#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "probe": "node scripts/probe.mjs"
  }
}
