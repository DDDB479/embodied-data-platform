{
  "name": "dsh-embodied-data",
  "version": "0.6.0",
  "description": "DSH plugin + MCP server platform for embodied-AI data production: persistent DAG pipelines, human review queues, processor plugins, delivery packs, CDR/RLDS decoding, quality gates, LeRobot/Zarr export, cataloging and storage. Works with any MCP client.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./mcp": "./src/mcp.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "python",
    "scripts/probe.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "mcp-server",
    "embodied-ai",
    "robotics",
    "lerobot",
    "dataset",
    "data-quality"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDB479/embodied-data-platform.git"
  },
  "homepage": "https://github.com/DDDB479/embodied-data-platform#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs",
    "probe": "node scripts/probe.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
